; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot"
run/main_scene="uid://cruwicjsr2e6i"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GDRx="*res://addons/reactivex/__gdrxsingleton__.gd"
AutoloadCommonUtility="*res://Scripts/Runtime/[MyProject]/Autoloads/CommonUtility.gd"
AutoloadAudioManager="*res://Scripts/Runtime/[MyProject]/Autoloads/AudioManager.gd"

[dotnet]

project/assembly_name="Godot"

[editor_plugins]

enabled=PackedStringArray("res://addons/RandomizeLevelTool/plugin.cfg", "res://addons/reactivex/plugin.cfg", "res://addons/simple_dependency_injection/plugin.cfg")

[file_customization]

folder_colors={
"res://Scripts/": "yellow",
"res://Scripts/Runtime/[MyProject]/Constructs/": "orange",
"res://Scripts/Runtime/[MyProject]/Constructs/Entities/": "purple",
"res://Scripts/Runtime/[MyProject]/Constructs/Levels/": "green",
"res://Scripts/Runtime/[MyProject]/Constructs/Screens/": "blue"
}

